# ============================================================
# AURIGA - Configuration environment (copier vers .env)
# NE JAMAIS COMMITTER LE FICHIER .env
# ============================================================

# --- Alpaca (paper trading) ---
# Créer un compte paper : https://app.alpaca.markets/paper
# Clés API paper depuis le dashboard (URL contient "paper-api")
# ⚠️ À REMPLIR DANS .env (jamais dans .env.example committé)
ALPACA_API_KEY=YOUR_PAPER_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET_KEY_HERE
ALPACA_PAPER=true
# N'utiliser que des données IEX (gratuit) pour le MVP
ALPACA_FEED=iex

# --- LLM (OpenRouter pour le narratif quotidien) ---
OPENROUTER_API_KEY=
# Modèle par défaut pour le narratif (léger, rapide)
AURIGA_LLM_MODEL=deepseek/deepseek-chat

# --- Configuration AURIGA ---
# Timeframes de recherche (1H principal, 1D pour validation croisée)
AURIGA_TIMEFRAMES=1H,1D
# Années d'historique à télécharger
AURIGA_HISTORY_YEARS=5
# Univers : fichier dans config/ ou liste séparée par virgules
AURIGA_UNIVERSE_FILE=config/universe.yaml
# Nombre max de positions simultanées
AURIGA_MAX_POSITIONS=12
# Limite de perte quotidienne (fraction du capital, ex: -0.02 = -2%)
AURIGA_DAILY_LOSS_LIMIT=0.02
# Exposure max par actif (fraction)
AURIGA_MAX_ASSET_EXPOSURE=0.10
# Répertoire des données
AURIGA_DATA_DIR=data
AURIGA_OUTPUTS_DIR=outputs